{
  "name": "@evolve/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Serveur de jeu autoritaire EVOLVE.IO (Colyseus).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --conditions=@evolve/source --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "tsx --conditions=@evolve/source scripts/benchSimulation.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@colyseus/core": "0.18.23",
    "@colyseus/schema": "5.0.42",
    "@colyseus/ws-transport": "0.18.4",
    "@evolve/shared": "workspace:*",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.6",
    "@types/express": "^5.0.3",
    "@types/node": "~22.19.0",
    "tsx": "^4.20.0",
    "vitest": "~5.0.5"
  }
}
