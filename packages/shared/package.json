{
  "name": "@evolve/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Types, constantes, schéma d'état et règles partagés entre le client et le serveur EVOLVE.IO.",
  "exports": {
    ".": {
      "@evolve/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@colyseus/schema": "5.0.42"
  },
  "devDependencies": {
    "vitest": "~5.0.5"
  }
}
